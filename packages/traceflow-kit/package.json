{
  "name": "traceflow-kit",
  "version": "0.1.0",
  "description": "CLI, API local y Studio visual para desarrollar con TraceFlow",
  "type": "commonjs",
  "main": "./dist/traceflow-kit.js",
  "types": "./dist/traceflow-kit.d.ts",
  "exports": {
    ".": {
      "types": "./dist/traceflow-kit.d.ts",
      "require": "./dist/traceflow-kit.js",
      "default": "./dist/traceflow-kit.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "traceflow-kit": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node ../../scripts/clean.script.js packages/traceflow-kit/dist",
    "prebuild": "npm run build --workspace=traceflow",
    "build": "npm run clean && tsc -p tsconfig.build.json && vite build --config studio/vite.config.ts",
    "build:typescript": "tsc -p tsconfig.build.json",
    "build:studio": "vite build --config studio/vite.config.ts",
    "dev:kit": "concurrently -k -n kit-compiler,kit-server -c magenta,magenta \"npm run dev:kit:compile\" \"tsx watch dist/cli.js studio --no-open\"",
    "dev:kit:compile": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:studio": "vite --config studio/vite.config.ts",
    "pretypecheck": "npm run build --workspace=traceflow",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p studio/tsconfig.json",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "keywords": [
    "traceflow",
    "tracing",
    "studio",
    "observability"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.2.3",
    "@nestjs/swagger": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "fastify": "5.11.3",
    "open": "^10.2.0",
    "react-router-dom": "^7.18.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "traceflow": "0.1.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0"
  }
}
